<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_lienzo"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- HUD superior -->
    <LinearLayout
        android:id="@+id/hud_superior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Píldora de monedas -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/fondo_pildora"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_moneda" />

            <TextView
                android:id="@+id/txt_monedas_juego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Badge central de Nivel -->
        <LinearLayout
            android:layout_width="112dp"
            android:layout_height="52dp"
            android:background="@drawable/fondo_tarjeta_shadcn"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_nivel_corto"
                android:textColor="@color/texto_tenue"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txt_numero_nivel_juego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/texto_primario"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Botón palabras encontradas -->
        <FrameLayout
            android:id="@+id/btn_palabras_encontradas"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/fondo_pildora"
            android:clickable="true"
            android:contentDescription="@string/titulo_palabras_encontradas"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_libro"
                app:tint="@color/texto_primario" />
        </FrameLayout>

        <!-- Botón configuración rápida -->
        <FrameLayout
            android:id="@+id/btn_pausa_juego"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fondo_pildora"
            android:clickable="true"
            android:contentDescription="@string/titulo_configuracion"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_configuracion"
                app:tint="@color/texto_primario" />
        </FrameLayout>
    </LinearLayout>

    <!-- Barra de progreso de puntos del nivel -->
    <FrameLayout
        android:id="@+id/contenedor_barra_puntos"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/fondo_pildora"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hud_superior">

        <ProgressBar
            android:id="@+id/barra_puntos_nivel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progreso_nivel" />

        <TextView
            android:id="@+id/txt_puntos_nivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:textColor="@color/texto_primario"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Subtítulo discreto del piso actual -->
    <TextView
        android:id="@+id/txt_piso_en_juego"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/texto_tenue"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedor_barra_puntos" />

    <!-- Píldora de vista previa de la palabra activa + burbuja de puntaje (visible solo al seleccionar) -->
    <FrameLayout
        android:id="@+id/contenedor_preview_palabra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_piso_en_juego">

        <TextView
            android:id="@+id/txt_palabra_actual"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fondo_preview_palabra"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:minWidth="172dp"
            android:paddingHorizontal="26dp"
            android:textColor="@color/texto_primario"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_puntos_preview"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/fondo_burbuja_puntos"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="32dp"
            android:paddingHorizontal="8dp"
            android:textColor="#2A120E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- Mensaje breve de estado (válida, repetida, no existe) -->
    <TextView
        android:id="@+id/txt_estado_palabra"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/texto_tenue"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedor_preview_palabra" />

    <!-- Tablero Hexagonal Fijo (18 celdas, 4-3-4-3-4) -->
    <com.estructura.datos.cletter.interfaz.juego.VistaTableroHexagonal
        android:id="@+id/tablero_hexagonal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/barra_acciones_juego"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_estado_palabra" />

    <!-- Barra inferior de acciones (Pista y Mezclar) -->
    <LinearLayout
        android:id="@+id/barra_acciones_juego"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btn_pista"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/fondo_pildora"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pista"
                app:tint="@color/marca_primario" />

            <TextView
                android:id="@+id/txt_btn_pista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_mezclar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/fondo_pildora"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mezclar"
                app:tint="@color/marca_primario" />

            <TextView
                android:id="@+id/txt_btn_mezclar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
